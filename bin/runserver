#!/usr/bin/env bash
# RunServer CLI entry — resolves the real entry script relative to this file
# so `npm link`, `npm i -g`, and Homebrew installs all work.
#
# Layout, depending on install form:
#   - npm / source / git clone:  bin/runserver  →  ../src/cli.mjs
#   - Homebrew:                  bin/runserver  →  ../share/runserver/src/cli.mjs
#                                    (because bin.install places bin/ in <prefix>/bin
#                                     and pkgshare.install places src/ under
#                                     <prefix>/share/runserver/src)
#
# We probe both paths so the same wrapper works for every install form.
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
if command -v realpath >/dev/null 2>&1; then
  RESOLVED="$(realpath "$SOURCE")"
else
  while [ -L "$SOURCE" ]; do
    TARGET="$(readlink "$SOURCE")"
    case "$TARGET" in
      /*) SOURCE="$TARGET" ;;
      *) SOURCE="$(dirname "$SOURCE")/$TARGET" ;;
    esac
  done
  RESOLVED="$SOURCE"
fi
SCRIPT_DIR="$(cd "$(dirname "$RESOLVED")" && pwd)"
ENTRY=""
for candidate in \
  "${SCRIPT_DIR}/../src/cli.mjs" \
  "${SCRIPT_DIR}/../share/runserver/src/cli.mjs"; do
  if [ -f "$candidate" ]; then ENTRY="$candidate"; break; fi
done
if [ -z "$ENTRY" ]; then
  echo "runserver: cannot locate src/cli.mjs (looked in ${SCRIPT_DIR}/../src and ${SCRIPT_DIR}/../share/runserver/src)" >&2
  exit 127
fi
exec node "$ENTRY" "$@"
